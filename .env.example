# Database
DATABASE_URL=postgresql://sis:sis@localhost:5437/sis_demo

# Public URLs (production)
APP_URL=https://sis.skylarbarnes.com
API_PUBLIC_URL=https://sis-api.skylarbarnes.com
CORS_ORIGIN=https://sis.skylarbarnes.com
SESSION_COOKIE_DOMAIN=.skylarbarnes.com
TRUST_PROXY=true

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# SAML 2.0 (Okta) — required for SAML login
# Okta → Applications → Your SAML app → Sign On → View SAML setup instructions
SAML_ENTRY_POINT=https://YOUR-ORG.okta.com/app/YOUR_APP_ID/sso/saml
SAML_IDP_ISSUER=http://www.okta.com/exkzbhs8gnYwIJLT11d7
SAML_CERT_PATH=certs/okta-idp.pem
# Or inline (use \n between lines): SAML_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
SAML_LOGOUT_URL=

# OAuth 2.0 — custom AS (see docs/okta-as-config.json). Audience must equal MCP resource URL.
OKTA_ISSUER=https://sledai.oktapreview.com/oauth2/auszblykhlQkrnOmA1d7
OKTA_AUDIENCE=https://sis-api.skylarbarnes.com/mcp
MCP_RESOURCE_URL=https://sis-api.skylarbarnes.com/mcp
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_TOKEN_URL=https://sledai.oktapreview.com/oauth2/auszblykhlQkrnOmA1d7/v1/token

# SCIM (Okta pulls students from SIS)
SCIM_API_TOKEN=change-me-scim-bearer-token

# SIS → Okta push (Management API; student CRUD syncs to Okta Users API)
# Create an API token: Security → API → Tokens → Create token (okta.users.manage)
OKTA_ORG_URL=https://YOUR-ORG.oktapreview.com
# Token only (no "SSWS " prefix). Quote if the value contains spaces.
OKTA_API_TOKEN=
OKTA_PUSH_ENABLED=true
# OKTA_PUSH_REQUIRED=false
# OKTA_PUSH_EXTENDED_PROFILE=true
# OKTA_STUDENT_GROUP_IDS=00gxxxxxxxx

# App
API_PORT=3010
NODE_ENV=production

# Web dev (Vite) — proxy target when UI and API run separately locally
# VITE_API_URL=https://sis-api.skylarbarnes.com
# VITE_API_PROXY_TARGET=http://localhost:3010

# MCP Server
SIS_API_URL=https://sis-api.skylarbarnes.com
# Loopback for delegated chat tools (avoids hairpin via Cloudflare)
# SIS_API_INTERNAL_URL=http://127.0.0.1:3010
# OIDC sign-on key (SIS Admins app) — separate from agent key for ID-JAG hops
OKTA_OIDC_PRIVATE_KEY_PATH=secrets/app-sign-on-key.json
SIS_OAUTH_TOKEN=

# Admin chatbot (set at least one LLM key)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OIDC login for admins (preferred over SAML for agent id_token + chat)
OKTA_OIDC_CLIENT_ID=
# client_secret | private_key_jwt (auto when AGENT key + same client id as OKTA_OIDC_CLIENT_ID)
# OKTA_OIDC_AUTH_METHOD=private_key_jwt
OKTA_OIDC_CLIENT_SECRET=
OKTA_OIDC_REDIRECT_URI=https://sis-api.skylarbarnes.com/auth/oidc/callback
OIDC_SCOPES=openid profile email groups

# Okta AI agent ID-JAG (delegated sis.* scopes for Ask SIS)
OKTA_AGENT_REGISTRATION_ID=wlpzfntwqat4SXBba1d7
AGENT_CLIENT_ID=wlpzfntwqat4SXBba1d7
AGENT_PRIVATE_KEY_PATH=secrets/agent-private-key.json
RESOURCE_AS_ISSUER=https://sledai.oktapreview.com/oauth2/auszblykhlQkrnOmA1d7
AGENT_TOKEN_SCOPE=sis.students.read sis.students.write sis.students.ferpa sis.students.financial sis.students.ada sis.students.disciplinary sis.students.counselor sis.students.risk sis.students.academic sis.admin

# Demo admins: comma-separated emails always granted the admin role, checked
# BEFORE Okta group membership. Leave EMPTY so Okta groups are the only path to
# admin; populate only for a local demo where you control the accounts.
DEMO_ADMIN_EMAILS=
